# cluster.env — параметры кластера. Скопируйте в config/cluster.env и заполните.
#
#   cp config/cluster.env.example config/cluster.env
#
# ВАЖНО: config/cluster.env добавлен в .gitignore и НЕ должен попадать в git —
# в нём пароли. Значения из окружения имеют приоритет над этим файлом.

# --- идентификация кластера и узла -----------------------------------------

# Имя Galera-кластера. Одинаковое на всех узлах.
CLUSTER_NAME=asterisk_prod

# Имя этого узла: только a-z, 0-9, дефис. Попадает в wsrep_node_name,
# в systemname Asterisk и в имя межузлового транка (node-<имя>).
NODE_NAME=

# IP этого узла в межузловой сети (VPN/L2). Именно по нему ходят Galera и SIP.
NODE_IP=

# Полный список IP ВСЕХ узлов кластера через запятую, включая этот.
# Черновик указывал только "мастер + сам себя" — из-за этого узлы не находили
# друг друга после полного рестарта кластера. Список должен быть полным
# и одинаковым на всех узлах.
PEERS=

# --- база данных ------------------------------------------------------------

DB_NAME=asterisk
CDR_DB_NAME=asteriskcdrdb

# Пользователь для SST (перенос дампа при вступлении узла в кластер).
SST_USER=sst_user
SST_PASS=

# Пользователь Asterisk для realtime (ODBC).
RT_USER=asterisk_rt
RT_PASS=

# Пользователь провижининга: только SELECT и только на нужные таблицы.
PROV_DB_USER=prov_ro
PROV_DB_PASS=

# --- сеть -------------------------------------------------------------------

# Подсеть(и), которые Asterisk считает локальными (для NAT-логики PJSIP).
LOCAL_NET=10.0.0.0/8

# Откуда разрешён SSH и доступ к админ-интерфейсам. НЕ оставляйте 0.0.0.0/0.
ADMIN_CIDR=10.0.0.0/8

# Подсеть, в которой стоят телефоны — с неё разрешается провижининг.
PHONE_CIDR=10.0.0.0/8

# Подсеть межузлового взаимодействия (Galera + SIP между узлами).
CLUSTER_CIDR=10.0.0.0/8

SIP_PORT=5060
SIP_TLS_PORT=5061
RTP_START=10000
RTP_END=20000

# --- провижининг ------------------------------------------------------------

PROV_PORT=8443
# Секрет для HMAC-токенов провижининга. Генерируется автоматически, если пуст.
PROV_HMAC_SECRET=
# Глобальный токен в URL провижининга (DHCP option 66). Пусто = выключено.
PROV_STATIC_TOKEN=

# --- версии -----------------------------------------------------------------

# Мажорная версия Asterisk. ОБЯЗАНА совпадать на всех узлах, иначе
# realtime-схема ps_* разъедется между узлами.
ASTERISK_MAJOR=21

# Репозиторий Sangoma, из которого ставится Asterisk на secondary-узлы,
# чтобы версия совпадала с той, что поставил инсталлятор FreePBX на мастере.
ASTERISK_REPO_URL=http://deb.freepbx.org/freepbx17-prod
ASTERISK_REPO_SUITE=bookworm
ASTERISK_REPO_KEY_URL=http://deb.freepbx.org/gpg/aptly-pubkey.asc
