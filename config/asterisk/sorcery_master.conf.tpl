; /etc/asterisk/sorcery.conf для МАСТЕРА (под управлением FreePBX).
;
; Отличие от secondary принципиальное: endpoint/auth/aor на мастере остаются
; статическими — их генерирует FreePBX из своих таблиц при Apply Config.
; Если добавить сюда ещё и realtime, каждый добавочный будет виден дважды
; (статикой и из ps_endpoints, куда его выгружает sync-config.py).
;
; В realtime выносится только ОДНА сущность — contact. Именно она делает
; регистрации абонентов общими для всего кластера и позволяет маршрутизировать
; вызов на ту площадку, где абонент реально находится.

[res_pjsip_registrar]
contact=realtime,ps_contacts
