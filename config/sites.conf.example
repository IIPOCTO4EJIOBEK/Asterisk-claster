# sites.conf — соответствие площадок и диапазонов внутренних номеров.
# Используется scripts/epm-set-site.py для привязки телефонов Endpoint
# Manager к их площадкам (основной регистратор).
#
# Формат:  имя-площадки : IP её Asterisk : диапазоны добавочных через запятую
#
# Имя площадки должно совпадать с --node-name соответствующего узла —
# по нему же строится имя межузлового транка node-<имя>.
#
# Диапазоны не должны пересекаться: телефон получает площадку первого
# совпадения, и пересечение молча отдаст его не туда.

rostov:10.1.10.111:1000-1999,10800-10999
voronezh:10.4.3.6:2000-2999
slavyansk:10.5.1.4:3000-3999
